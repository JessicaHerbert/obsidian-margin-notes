{
  "name": "margin-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Notion-style margin comments for Obsidian, stored in the note so AI assistants can read and answer them",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "install-plugin": "npm run build && node install.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "obsidian": "^1.8.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
